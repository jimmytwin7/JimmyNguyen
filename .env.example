# Copy to .env.local and fill in real values. .env.local is gitignored.
#
# These are only needed if you want to regenerate the travel photo manifest
# (`npm run refresh:photos`). The site itself builds and runs without them —
# it reads the committed manifest, so no Cloudinary credentials are required
# for `npm run dev`, `npm run build`, or deployment.

# Cloudinary cloud name. Public — it appears in every image delivery URL.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Cloudinary Admin API credentials, read ONLY by scripts/refresh-photos.mjs.
# Secrets: no NEXT_PUBLIC_ prefix, so they are never bundled into the client.
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ---------------------------------------------------------------------------
# Scrambl (/cooking) — all optional. Server-only: never prefix these with
# NEXT_PUBLIC_. The feature works with none of them set.
# ---------------------------------------------------------------------------

# TheMealDB supporter key, read ONLY by scripts/fetch-recipes.mjs at build
# time (prebuild), never at runtime. Defaults to the public test key "1".
# With a key set, a failed catalog fetch fails the build.
RECIPE_API_KEY=

# ---------------------------------------------------------------------------
# Contact form (home page) — all optional, server-only, never NEXT_PUBLIC_.
# The form appears only when ALL THREE are set. They are read at build time to
# decide whether to show it, so redeploy after changing them.
# ---------------------------------------------------------------------------

# Resend API key (https://resend.com/api-keys). Also signs the anti-spam token.
RESEND_API_KEY=
# Inbox that receives messages.
CONTACT_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. "Portfolio <contact@yourdomain.com>".
CONTACT_FROM_EMAIL=
